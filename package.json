{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter=./packages/** --parallel build",
    "build:all": "pnpm build && pnpm --filter=./playground/** --parallel build",
    "build:core": "pnpm --filter ./packages/void build",
    "build:docs": "pnpm --filter ./docs build",
    "check": "pnpm -r --parallel typecheck",
    "deploy:docs": "pnpm --filter ./docs run deploy --project void-docs",
    "deploy:staging:docs": "pnpm --filter ./docs run deploy --project void-docs-staging",
    "dev:docs": "cd docs && pnpm dev",
    "fmt": "oxfmt --write .",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest --run",
    "test:all": "pnpm build:all && pnpm check && pnpm lint && pnpm test",
    "test:integration": "vitest --run --project core-markdown",
    "test:metaframeworks": "vitest --run --project metaframeworks",
    "test:pages:react-vue": "vitest --run --project pages-react-vue",
    "test:pages:svelte-solid": "vitest --run --project pages-svelte-solid",
    "test:unit": "vitest --run --project unit"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@typescript/native-preview": "catalog:",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.61.0",
    "playwright": "^1.59.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3"
}
