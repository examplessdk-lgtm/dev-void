{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter './packages/**' --parallel build",
    "build:core": "vp run --filter ./packages/void build",
    "build:docs": "vp run --filter ./docs build",
    "check": "vp run -r --parallel typecheck",
    "deploy:docs": "vp run build:core && vp run --filter ./docs deploy",
    "dev:docs": "vp run --filter ./docs dev",
    "fmt": "vp fmt --write .",
    "lint": "vp lint",
    "prepare": "vp config",
    "test": "vp test run",
    "test:integration": "vp test run --project core-markdown",
    "test:metaframeworks": "vp test run --project metaframeworks",
    "test:pages:react-vue": "vp test run --project pages-react-vue",
    "test:pages:svelte-solid": "vp test run --project pages-svelte-solid",
    "test:unit": "vp test run --project unit"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@typescript/native-preview": "catalog:",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.59.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.2"
}
