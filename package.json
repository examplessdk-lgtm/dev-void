{
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "pnpm build && pnpm -F './playground/**' --parallel build",
    "build:core": "pnpm -F void build",
    "build:docs": "pnpm -F docs build",
    "build": "pnpm -F './packages/**' --parallel build",
    "check": "pnpm -r --parallel typecheck",
    "deploy:docs": "pnpm -F docs run deploy --project void-docs",
    "deploy:staging:docs": "pnpm -F docs run deploy --project void-docs-staging",
    "dev:docs": "cd docs && pnpm dev",
    "fmt": "oxfmt --write .",
    "lint": "oxlint",
    "prepare": "husky",
    "test:integration": "vitest --run --project core-markdown",
    "test:metaframeworks": "vitest --run --project metaframeworks",
    "test:pages:react-vue": "vitest --run --project pages-react-vue",
    "test:pages:svelte-solid": "vitest --run --project pages-svelte-solid",
    "test:unit": "vitest --run --project unit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "playwright": "^1.58.2",
    "vitest": "^4.1.1"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "pnpm@10.29.3"
}
