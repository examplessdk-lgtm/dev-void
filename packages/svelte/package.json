{
  "name": "@void/svelte",
  "version": "0.10.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./App.svelte": {
      "svelte": "./src/runtime/App.svelte",
      "default": "./src/runtime/App.svelte"
    },
    "./prefetch": {
      "default": "./src/runtime/prefetch.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pathe": "catalog:",
    "svelte": "^5.56.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^8.0.0",
    "void": "workspace:*"
  }
}
