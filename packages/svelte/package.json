{
  "name": "@void-sdk/svelte",
  "version": "0.4.0",
  "files": [
    "dist",
    "src/runtime"
  ],
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./App.svelte": {
      "svelte": "./src/runtime/App.svelte",
      "default": "./src/runtime/App.svelte"
    },
    "./prefetch": {
      "default": "./src/runtime/prefetch.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pathe": "catalog:",
    "svelte": "^5.55.4",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "void": "workspace:@void-sdk/void@*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "catalog:",
    "void": "workspace:@void-sdk/void@*"
  }
}
