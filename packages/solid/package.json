{
  "name": "@void/solid",
  "version": "0.0.1",
  "files": [
    "dist",
    "src/runtime"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./context": {
      "default": "./src/runtime/context.ts"
    },
    "./prefetch": {
      "default": "./src/runtime/prefetch.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "vite-plugin-solid": "^2.11.11"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "solid-js": "^1.9.12",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "void": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": "catalog:",
    "void": "workspace:*"
  }
}
