{
  "name": "@void/solid",
  "version": "0.10.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./context": {
      "default": "./src/runtime/context.ts"
    },
    "./prefetch": {
      "default": "./src/runtime/prefetch.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "vite-plugin-solid": "^2.11.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pathe": "catalog:",
    "solid-js": "^1.9.14",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": "^8.0.0",
    "void": "workspace:*"
  }
}
