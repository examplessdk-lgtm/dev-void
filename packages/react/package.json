{
  "name": "@void/react",
  "version": "1.1.11",
  "description": "React pages, server rendering, forms, and navigation for Void.",
  "homepage": "https://void.cloud",
  "bugs": {
    "url": "https://github.com/voidzero-dev/void/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./pages-client": {
      "types": "./dist/runtime/pages-client.d.mts",
      "import": "./dist/runtime/pages-client.mjs"
    },
    "./pages-server": {
      "types": "./dist/runtime/pages-server.d.mts",
      "import": "./dist/runtime/pages-server.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pathslash": "^0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^6.0.0",
    "vite-plus": "^1.2.0",
    "void": "*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "void": "*"
  }
}
