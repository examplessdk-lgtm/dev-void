{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "paths": {
      "*": ["./*"],
      "void": ["./src/index.ts"],
      "void/*": ["./src/*"],
      "void/routes": ["./src/routes-stub.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "@cloudflare/workers-types"],
    "isolatedDeclarations": true
  },
  "include": ["src", "test", "env.d.ts"]
}
