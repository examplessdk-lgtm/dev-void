{
  "name": "@void/platform",
  "version": "0.10.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/platform"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "import": "./dist/installer.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-runtime.mjs",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pathslash": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
