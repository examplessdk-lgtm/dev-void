---
export const prerender = false;

import { db, eq } from "void/db";
import { kv } from "void/kv";
import { users } from "@schema";

await db.insert(users).values({ id: 1, name: "Alice", email: "alice@example.com" }).onConflictDoNothing();

const rows = await db.select({ name: users.name }).from(users).where(eq(users.id, 1));
const result = rows[0] ?? null;

await kv.put("smoke", "ok");
const kvValue = await kv.get<string>("smoke");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smoke Test</title>
  </head>
  <body>
    <h1>Smoke Test</h1>
    <p>D1 user: <span data-testid="d1-user">{result?.name ?? "none"}</span></p>
    <p>KV value: <span data-testid="kv-value">{kvValue ?? "none"}</span></p>
  </body>
</html>
