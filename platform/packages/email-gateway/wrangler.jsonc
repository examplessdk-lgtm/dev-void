{
  "name": "void-email-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [{ "binding": "API", "service": "void-api" }],
  "dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "void-users" }],
  "kv_namespaces": [{ "binding": "ROUTING", "id": "9250c33f3db6494ebe8ad6272812c8c0" }],
  "send_email": [{ "name": "SEND_EMAIL" }],
  "vars": {
    "EMAIL_SENDER_DOMAIN": "mail.void.cloud",
    "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
    "EMAIL_SHARED_ZONE_ID": "5b66f5cb84fd7dcfdd0170515e622181",
    "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway",
  },
  "env": {
    "production": {
      "name": "void-email-gateway",
      "workers_dev": true,
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "services": [{ "binding": "API", "service": "void-api" }],
      "dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "void-users" }],
      "kv_namespaces": [{ "binding": "ROUTING", "id": "9250c33f3db6494ebe8ad6272812c8c0" }],
      "send_email": [{ "name": "SEND_EMAIL" }],
      "vars": {
        "EMAIL_SENDER_DOMAIN": "mail.void.cloud",
        "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
        "EMAIL_SHARED_ZONE_ID": "5b66f5cb84fd7dcfdd0170515e622181",
        "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway",
      },
    },
    "staging": {
      "name": "void-email-gateway-staging",
      "workers_dev": true,
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "services": [{ "binding": "API", "service": "void-api-staging" }],
      "dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "void-users-staging" }],
      "kv_namespaces": [{ "binding": "ROUTING", "id": "60240eecea804f39bf8b7395cd6c6b08" }],
      "send_email": [{ "name": "SEND_EMAIL" }],
      "vars": {
        "EMAIL_SENDER_DOMAIN": "mail.voidcloud.dev",
        "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
        "EMAIL_SHARED_ZONE_ID": "57fc5c5286e74843013704368205de38",
        "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway-staging",
      },
    },
  },
}
