{
  "name": "@voidcloud/api",
  "private": true,
  "type": "module",
  "exports": {
    "./tiers": "./src/tiers.ts",
    "./api": "./src/api.ts",
    "./reserved-slugs": "./src/reserved-slugs.ts",
    "./routing": "./src/routing.ts",
    "./usage-auth": "./src/usage-auth.ts",
    "./admin-jsx/jsx-runtime": "./src/admin/react-jsx/jsx-runtime.ts",
    "./admin-jsx/jsx-dev-runtime": "./src/admin/react-jsx/jsx-dev-runtime.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "deploy": "node ../../scripts/wrangler-deploy.ts",
    "deploy:github-webhook-ingress": "node ../../scripts/wrangler-deploy.ts --config wrangler.github-webhook-ingress.jsonc",
    "dev": "wrangler dev",
    "migrate": "drizzle-kit migrate",
    "migrate:staging": "DATABASE_URL=$STAGING_DATABASE_URL drizzle-kit migrate",
    "setup": "node scripts/setup-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "1.0.0",
    "@nkzw/fate": "1.7.5",
    "@stylexjs/stylex": "catalog:",
    "@void/deploy-core": "workspace:*",
    "@void/edge": "workspace:*",
    "@void/isr": "workspace:*",
    "@void/platform": "workspace:*",
    "@void/react": "workspace:*",
    "@xterm/headless": "^6.0.0",
    "aws4fetch": "^1.0.20",
    "blake3-jit": "^1.1.0",
    "cron-parser": "5.10.1",
    "drizzle-orm": "^0.45.3",
    "hono": "catalog:platform",
    "jose": "6.2.12",
    "lucide-react": "1.49.0",
    "mime": "^4.1.0",
    "oauth4webapi": "catalog:",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-fate": "1.7.5",
    "void": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:platform",
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@voidzero-dev/vite-plus-prompts": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:platform"
  }
}
