{
  "name": "@voidcloud/api",
  "private": true,
  "type": "module",
  "exports": {
    "./tiers": "./src/tiers.ts",
    "./api": "./src/api.ts",
    "./reserved-slugs": "./src/reserved-slugs.ts",
    "./routing": "./src/routing.ts",
    "./usage-auth": "./src/usage-auth.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "deploy": "node ../../scripts/wrangler-deploy.ts",
    "deploy:github-webhook-ingress": "node ../../scripts/wrangler-deploy.ts --config wrangler.github-webhook-ingress.jsonc",
    "dev": "wrangler dev",
    "migrate": "drizzle-kit migrate",
    "migrate:staging": "DATABASE_URL=$STAGING_DATABASE_URL drizzle-kit migrate",
    "setup": "node scripts/setup-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@void/deploy-core": "workspace:*",
    "@void/isr": "workspace:*",
    "@xterm/headless": "^6.0.0",
    "aws4fetch": "^1.0.20",
    "blake3-jit": "^1.1.0",
    "cron-parser": "5.10.0",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:platform",
    "jose": "6.2.12",
    "mime": "^4.1.0",
    "oauth4webapi": "catalog:",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:platform",
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:platform"
  },
  "optionalDependencies": {
    "@clack/prompts": "^1.8.0"
  }
}
