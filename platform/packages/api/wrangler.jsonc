{
  "name": "void-api",
  "main": "src/worker/index.ts",
  "services": [
    {
      "binding": "PREVIEW_DISPATCH",
      "service": "void-dispatch",
      "entrypoint": "PreviewDispatcher",
    },
  ],
  "build": { "command": "node scripts/build-worker.mjs" },
  "alias": {
    "void:sandbox-controller-source": "./dist/sandbox-controller-source.ts",
    "@void/react/pages-server": "../../../packages/react/src/runtime/pages-server.ts",
    "@void/react": "../../../packages/react/src/runtime/index.ts",
    "void/pages-client": "../../../packages/void/src/pages/client.ts",
    "void/pages-head": "../../../packages/void/src/pages/head.ts",
    "void/pages-server": "../../../packages/void/src/pages/serialize.ts",
  },
  "assets": { "directory": "./dist/admin-assets" },
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "version_metadata": { "binding": "VERSION_METADATA" },
  // Both hosted PostgreSQL origins are in AWS us-east-2.
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-2",
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7bd6b2a606a347819ad3421867840736",
      // Local dev: `pnpm setup` creates the void_dev role and database
      "localConnectionString": "postgresql://void_dev:void_dev@localhost:5432/void_api_dev",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
    {
      "binding": "ISR_CACHE",
      "id": "7a0284b2390b42218901919579aadf0e",
    },
    {
      "binding": "STATIC_ASSETS",
      "id": "843a002c09eb4a2f910426212826b666",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STATIC_ASSETS_R2",
      "bucket_name": "void-static-assets-overflow",
    },
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCH",
      "namespace": "void-users",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_COUNTER",
        "class_name": "UsageCounter",
      },
      {
        "name": "CRON_SCHEDULER",
        "class_name": "CronScheduler",
      },
      {
        "name": "ERROR_ALERT_MONITOR",
        "class_name": "ErrorAlertMonitor",
      },
      {
        "name": "SANDBOX_CONCURRENCY_COUNTER",
        "class_name": "SandboxConcurrencyCounter",
      },
      {
        "name": "BUILD_SCHEDULER",
        "class_name": "BuildScheduler",
      },
      {
        "name": "BUILD_MANAGER",
        "class_name": "BuildManager",
      },
      {
        "name": "BUILD_MANAGER_LARGE",
        "class_name": "BuildManagerLarge",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["UsageCounter"],
    },
    {
      "tag": "v2",
      "new_classes": ["CronScheduler"],
    },
    {
      "tag": "v3",
      "new_classes": ["ErrorAlertMonitor"],
    },
    {
      "tag": "v4",
      "new_classes": ["SandboxConcurrencyCounter"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["BuildScheduler", "BuildManager"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["BuildManagerLarge"],
    },
  ],
  "containers": [
    {
      "class_name": "BuildManager",
      "image": "./container/Dockerfile",
      "image_build_context": "../../..",
      "max_instances": 50,
      // Free-plan build container: standard-3 = 2 vCPU / 8 GiB / 16 GB. (CF caps a
      // single container at standard-4 = 4 vCPU / 12 GiB / 20 GB, and custom types
      // require >=3 GiB/vCPU, so a 4-vCPU free box can't stay at 8 GiB.) Paid plans
      // use the BuildManagerLarge container below. Per-build routing by plan is in
      // src/build-scheduler.ts via builds.instance_type.
      "instance_type": "standard-3",
      // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
      // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
      "rollout_active_grace_period": 3900,
    },
    {
      "class_name": "BuildManagerLarge",
      "image": "./container/Dockerfile",
      "image_build_context": "../../..",
      "max_instances": 50,
      // Paid-plan build container: standard-4 = 4 vCPU / 12 GiB / 20 GB (the CF max).
      "instance_type": "standard-4",
      // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
      // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
      "rollout_active_grace_period": 3900,
    },
  ],
  "queues": {
    "producers": [
      { "binding": "CRON_FIRES_QUEUE", "queue": "void-cron-fires" },
      { "binding": "USAGE_EVENTS_QUEUE", "queue": "void-usage-events" },
      { "binding": "DEPLOYMENTS_QUEUE", "queue": "void-deployments" },
    ],
    "consumers": [
      {
        "queue": "void-usage-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
      },
      // Cron firings deferred from CronScheduler DO. See cron-fires-queue.ts
      // for why the DO can't dispatch directly.
      {
        "queue": "void-cron-fires",
        "max_batch_size": 50,
        "max_batch_timeout": 1,
        "max_retries": 3,
      },
      {
        "queue": "void-deployments",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "retry_delay": 60,
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["noreply@void.cloud", "noreply@mail.void.cloud"],
    },
  ],
  "triggers": {
    "crons": ["0 * * * *", "*/2 * * * *"],
  },
  "routes": [{ "pattern": "api.void.cloud", "custom_domain": true }],
  "vars": {
    "CRON_FIRES_QUEUE_NAME": "void-cron-fires",
    "DEPLOYMENTS_QUEUE_NAME": "void-deployments",
    "PLATFORM_ENV": "production",
    "AUTH_REDIRECT_URI": "https://api.void.cloud/auth/callback",
    "SANDBOX_CONTROL_SERVICE": "void-api",
    "PROXY_URL": "https://proxy.void.cloud",
    "REQUESTS_DATASET": "void_requests",
    "TAIL_SERVICE_NAME": "void-tail",
    // Must match packages/proxy/wrangler.jsonc — the proxy validates senders against its own copy.
    "EMAIL_SENDER_DOMAIN": "mail.void.cloud",
    "EMAIL_GATEWAY_ORIGIN": "https://void-email-gateway.voidzer0.workers.dev",
    "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
    "EMAIL_SHARED_ZONE_ID": "5b66f5cb84fd7dcfdd0170515e622181",
    "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway",
    // Bucket name plumbing for the presigned R2 PUT URL path. Must match the
    // `r2_buckets[].bucket_name` value above — the binding surfaces an
    // R2Bucket object but not its name, and the presigner needs the name.
    "R2_STATIC_ASSETS_BUCKET": "void-static-assets-overflow",
  },
  // Encrypted Worker secrets: CF_API_TOKEN, CF_ACCOUNT_ID, CF_ZONE_ID, JWT_SECRET, EMAIL_SIGNING_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
  // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are S3-compatible API tokens used to presign direct-to-R2 asset uploads (see src/r2-presign.ts).
  // OAuth browser consent uses the explicitly configured AUTH_REDIRECT_URI.
  // For local dev, set AUTH_REDIRECT_URI=http://localhost:8787/auth/callback and DEV_AUTH_BYPASS=true in .dev.vars
  // For local Hyperdrive, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@localhost:5432/void_api_dev in .dev.vars (run `pnpm setup` to auto-configure)
  "env": {
    "production": {
      "services": [
        {
          "binding": "PREVIEW_DISPATCH",
          "service": "void-dispatch",
          "entrypoint": "PreviewDispatcher",
        },
      ],
      "name": "void-api",
      "version_metadata": { "binding": "VERSION_METADATA" },
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7bd6b2a606a347819ad3421867840736",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "9250c33f3db6494ebe8ad6272812c8c0",
        },
        {
          "binding": "ISR_CACHE",
          "id": "7a0284b2390b42218901919579aadf0e",
        },
        {
          "binding": "STATIC_ASSETS",
          "id": "843a002c09eb4a2f910426212826b666",
        },
      ],
      "r2_buckets": [
        {
          "binding": "STATIC_ASSETS_R2",
          "bucket_name": "void-static-assets-overflow",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USAGE_COUNTER",
            "class_name": "UsageCounter",
          },
          {
            "name": "CRON_SCHEDULER",
            "class_name": "CronScheduler",
          },
          {
            "name": "ERROR_ALERT_MONITOR",
            "class_name": "ErrorAlertMonitor",
          },
          {
            "name": "SANDBOX_CONCURRENCY_COUNTER",
            "class_name": "SandboxConcurrencyCounter",
          },
          {
            "name": "BUILD_SCHEDULER",
            "class_name": "BuildScheduler",
          },
          {
            "name": "BUILD_MANAGER",
            "class_name": "BuildManager",
          },
          {
            "name": "BUILD_MANAGER_LARGE",
            "class_name": "BuildManagerLarge",
          },
        ],
      },
      "containers": [
        {
          "class_name": "BuildManager",
          "image": "./container/Dockerfile",
          "image_build_context": "../../..",
          "max_instances": 50,
          // Free-plan build container: standard-3 = 2 vCPU / 8 GiB / 16 GB. (CF caps a
          // single container at standard-4 = 4 vCPU / 12 GiB / 20 GB, and custom types
          // require >=3 GiB/vCPU, so a 4-vCPU free box can't stay at 8 GiB.) Paid plans
          // use the BuildManagerLarge container below. Per-build routing by plan is in
          // src/build-scheduler.ts via builds.instance_type.
          "instance_type": "standard-3",
          // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
          // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
          "rollout_active_grace_period": 3900,
        },
        {
          "class_name": "BuildManagerLarge",
          "image": "./container/Dockerfile",
          "image_build_context": "../../..",
          "max_instances": 50,
          // Paid-plan build container: standard-4 = 4 vCPU / 12 GiB / 20 GB (the CF max).
          "instance_type": "standard-4",
          // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
          // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
          "rollout_active_grace_period": 3900,
        },
      ],
      "queues": {
        "producers": [
          { "binding": "CRON_FIRES_QUEUE", "queue": "void-cron-fires" },
          { "binding": "USAGE_EVENTS_QUEUE", "queue": "void-usage-events" },
          { "binding": "DEPLOYMENTS_QUEUE", "queue": "void-deployments" },
        ],
        "consumers": [
          {
            "queue": "void-usage-events",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
          },
          {
            "queue": "void-cron-fires",
            "max_batch_size": 50,
            "max_batch_timeout": 1,
            "max_retries": 3,
          },
          {
            "queue": "void-deployments",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 60,
          },
        ],
      },
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true,
          "allowed_sender_addresses": ["noreply@void.cloud", "noreply@mail.void.cloud"],
        },
      ],
      "routes": [{ "pattern": "api.void.cloud", "custom_domain": true }],
      "vars": {
        "CRON_FIRES_QUEUE_NAME": "void-cron-fires",
        "DEPLOYMENTS_QUEUE_NAME": "void-deployments",
        "PLATFORM_ENV": "production",
        "AUTH_REDIRECT_URI": "https://api.void.cloud/auth/callback",
        "SANDBOX_CONTROL_SERVICE": "void-api",
        "PROXY_URL": "https://proxy.void.cloud",
        "REQUESTS_DATASET": "void_requests",
        "TAIL_SERVICE_NAME": "void-tail",
        "EMAIL_SENDER_DOMAIN": "mail.void.cloud",
        "EMAIL_GATEWAY_ORIGIN": "https://void-email-gateway.voidzer0.workers.dev",
        "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
        "EMAIL_SHARED_ZONE_ID": "5b66f5cb84fd7dcfdd0170515e622181",
        "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway",
        "R2_STATIC_ASSETS_BUCKET": "void-static-assets-overflow",
      },
    },
    "staging": {
      "services": [
        {
          "binding": "PREVIEW_DISPATCH",
          "service": "void-dispatch-staging",
          "entrypoint": "PreviewDispatcher",
        },
      ],
      "name": "void-api-staging",
      "version_metadata": { "binding": "VERSION_METADATA" },
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7cde35825e6249d0b60b9de69feb29dd",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
        {
          "binding": "ISR_CACHE",
          "id": "7f13ef3a3745445c883a5bbc72f031b7",
        },
        {
          "binding": "STATIC_ASSETS",
          "id": "4aaab48c46634a4a8cec69f23fde0504",
        },
      ],
      "r2_buckets": [
        {
          "binding": "STATIC_ASSETS_R2",
          "bucket_name": "void-static-assets-overflow-staging",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users-staging",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USAGE_COUNTER",
            "class_name": "UsageCounter",
          },
          {
            "name": "CRON_SCHEDULER",
            "class_name": "CronScheduler",
          },
          {
            "name": "ERROR_ALERT_MONITOR",
            "class_name": "ErrorAlertMonitor",
          },
          {
            "name": "SANDBOX_CONCURRENCY_COUNTER",
            "class_name": "SandboxConcurrencyCounter",
          },
          {
            "name": "BUILD_SCHEDULER",
            "class_name": "BuildScheduler",
          },
          {
            "name": "BUILD_MANAGER",
            "class_name": "BuildManager",
          },
          {
            "name": "BUILD_MANAGER_LARGE",
            "class_name": "BuildManagerLarge",
          },
        ],
      },
      "containers": [
        {
          "class_name": "BuildManager",
          "image": "./container/Dockerfile",
          "image_build_context": "../../..",
          "max_instances": 50,
          // Free-plan build container: standard-3 = 2 vCPU / 8 GiB / 16 GB. (CF caps a
          // single container at standard-4 = 4 vCPU / 12 GiB / 20 GB, and custom types
          // require >=3 GiB/vCPU, so a 4-vCPU free box can't stay at 8 GiB.) Paid plans
          // use the BuildManagerLarge container below. Per-build routing by plan is in
          // src/build-scheduler.ts via builds.instance_type.
          "instance_type": "standard-3",
          // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
          // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
          "rollout_active_grace_period": 3900,
        },
        {
          "class_name": "BuildManagerLarge",
          "image": "./container/Dockerfile",
          "image_build_context": "../../..",
          "max_instances": 50,
          // Paid-plan build container: standard-4 = 4 vCPU / 12 GiB / 20 GB (the CF max).
          "instance_type": "standard-4",
          // Don't SIGTERM an in-flight build during an api-worker rollout. 3900s = the
          // 60-min DEPLOY_TOKEN_HARD_MAX_MINUTES build cap + 5 min margin.
          "rollout_active_grace_period": 3900,
        },
      ],
      "queues": {
        "producers": [
          { "binding": "CRON_FIRES_QUEUE", "queue": "void-cron-fires-staging" },
          { "binding": "USAGE_EVENTS_QUEUE", "queue": "void-usage-events-staging" },
          { "binding": "DEPLOYMENTS_QUEUE", "queue": "void-deployments-staging" },
        ],
        "consumers": [
          {
            "queue": "void-usage-events-staging",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
          },
          {
            "queue": "void-cron-fires-staging",
            "max_batch_size": 50,
            "max_batch_timeout": 1,
            "max_retries": 3,
          },
          {
            "queue": "void-deployments-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 60,
          },
        ],
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@void.cloud", "noreply@mail.voidcloud.dev"],
        },
      ],
      "routes": [{ "pattern": "api.staging.void.cloud", "custom_domain": true }],
      "vars": {
        "CRON_FIRES_QUEUE_NAME": "void-cron-fires-staging",
        "DEPLOYMENTS_QUEUE_NAME": "void-deployments-staging",
        "DISPATCH_NAMESPACE": "void-users-staging",
        "DISPATCH_WORKER_NAME": "void-dispatch-staging",
        "VOID_PROXY_SERVICE": "void-proxy-staging",
        "SITE_DOMAIN": "staging.void.app",
        "DASHBOARD_URL": "https://dash.staging.void.cloud",
        "AUTH_REDIRECT_URI": "https://api.staging.void.cloud/auth/callback",
        "LOGS_DATASET": "void_logs_staging",
        "REQUESTS_DATASET": "void_requests_staging",
        "EMAIL_SENDER_DOMAIN": "mail.voidcloud.dev",
        "EMAIL_GATEWAY_ORIGIN": "https://void-email-gateway-staging.voidzer0.workers.dev",
        "EMAIL_SHARED_ACCOUNT_ID": "f721b8e515fbab226f41e2807edaece7",
        "EMAIL_SHARED_ZONE_ID": "57fc5c5286e74843013704368205de38",
        "EMAIL_SHARED_INGRESS_NAME": "void-email-gateway-staging",
        "PLATFORM_ENV": "staging",
        "SANDBOX_CONTROL_SERVICE": "void-api-staging",
        "PROXY_URL": "https://proxy.staging.void.cloud",
        "TAIL_SERVICE_NAME": "void-tail-staging",
        "R2_STATIC_ASSETS_BUCKET": "void-static-assets-overflow-staging",
      },
    },
  },
}
