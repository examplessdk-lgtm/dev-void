{
  // Optional source-runtime component. It is deliberately absent from the core
  // platform installer and from platform/package.json's aggregate deploy tasks.
  "name": "void-github-webhook-ingress",
  "main": "src/github-webhook-ingress.ts",
  "compatibility_date": "2026-02-12",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "services": [{ "binding": "API", "service": "void-api" }],
  "env": {
    "production": {
      "name": "void-github-webhook-ingress",
      "workers_dev": true,
      "preview_urls": false,
      "services": [{ "binding": "API", "service": "void-api" }],
    },
    "staging": {
      "name": "void-github-webhook-ingress-staging",
      "workers_dev": true,
      "preview_urls": false,
      "services": [{ "binding": "API", "service": "void-api-staging" }],
    },
  },
}
