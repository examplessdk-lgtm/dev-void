{
  "name": "void-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "ROUTING",
      "id": "9250c33f3db6494ebe8ad6272812c8c0",
    },
  ],
  "services": [
    {
      "binding": "API",
      "service": "void-api",
    },
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCH",
      "namespace": "void-users",
    },
  ],
  // Account-level send_email binding. No allowed_destination_addresses or
  // destination_address — API admission decides which recipients each project
  // may reach. CF accepts sends to any verified destination on the platform CF
  // account.
  //
  // Wrangler does NOT inherit send_email (or vars) into a named env, and
  // `deploy` runs `--env production`, so every scope below repeats both.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Platform mail zone for this environment. Read by src/email.ts and
  // src/email-router.ts; mirrored to deployed user workers as the
  // __VOID_EMAIL_DOMAIN binding. Never defaulted in code.
  "vars": { "EMAIL_SENDER_DOMAIN": "mail.void.cloud" },
  // Encrypted Worker secrets: JWT_SECRET, EMAIL_SIGNING_SECRET, CF_ACCOUNT_ID, CF_API_TOKEN
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [{ "pattern": "proxy.void.cloud", "custom_domain": true }],
  "env": {
    "production": {
      "name": "void-proxy",
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "9250c33f3db6494ebe8ad6272812c8c0",
        },
      ],
      "services": [
        {
          "binding": "API",
          "service": "void-api",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users",
        },
      ],
      "send_email": [{ "name": "SEND_EMAIL" }],
      "vars": { "EMAIL_SENDER_DOMAIN": "mail.void.cloud" },
      "routes": [{ "pattern": "proxy.void.cloud", "custom_domain": true }],
    },
    "staging": {
      "name": "void-proxy-staging",
      "secrets": { "required": ["EMAIL_SIGNING_SECRET"] },
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        {
          "binding": "ROUTING",
          "id": "60240eecea804f39bf8b7395cd6c6b08",
        },
      ],
      "services": [
        {
          "binding": "API",
          "service": "void-api-staging",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCH",
          "namespace": "void-users-staging",
        },
      ],
      "send_email": [{ "name": "SEND_EMAIL" }],
      "vars": { "EMAIL_SENDER_DOMAIN": "mail.voidcloud.dev" },
      "routes": [{ "pattern": "proxy.staging.void.cloud", "custom_domain": true }],
    },
  },
}
