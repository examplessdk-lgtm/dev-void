{
  "schemaVersion": 1,
  "displayName": "Void Cloud",
  "installationSlug": "cloud",
  "application": {
    "baseDomain": "void.app",
    "zoneName": "void.app",
    "dedicatedZone": true
  },
  "controlPlane": {
    "apiHostname": "api.void.cloud",
    "dashboardHostname": "dash.void.cloud",
    "proxyHostname": "proxy.void.cloud"
  },
  "authentication": {
    "providers": ["github", "google"]
  },
  "capabilities": {
    "ai": true,
    "customDomains": true,
    "email": true,
    "githubActions": true,
    "githubOAuth": true,
    "googleOAuth": true,
    "managedBuilds": true,
    "sandbox": true
  },
  "resources": {
    "aiGateway": "void",
    "apiWorker": "void-api",
    "assetsBucket": "void-static-assets-overflow",
    "cronQueue": "void-cron-fires",
    "dashboardWorker": "void-dashboard",
    "dispatchNamespace": "void-users",
    "dispatchWorker": "void-dispatch",
    "hyperdrive": "void-api",
    "isrCacheKv": "void-isr-cache",
    "legacyAssetsKv": "void-static-assets",
    "logsDataset": "void_logs",
    "proxyWorker": "void-proxy",
    "requestsDataset": "void_requests",
    "routingKv": "void-routing",
    "tailWorker": "void-tail",
    "usageQueue": "void-usage-events"
  }
}
